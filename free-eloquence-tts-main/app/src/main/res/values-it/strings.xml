    <string name="go_back">Indietro</string>
    <string name="welcome_title">Benvenuto in OpenEVV</string>
    <string name="welcome_alternative">Una voce gratuita che legge per te, senza abbonamento.</string>
    <string name="welcome_free">Senza pagamenti, account o abbonamenti. Il motore completo è incluso.</string>
    <string name="welcome_intro">Il motore è pronto. Scopri le funzioni e le autorizzazioni che mantengono attiva la voce.</string>
    <string name="welcome_features">Funzioni</string>
    <string name="welcome_voices">Nove voci</string>
    <string name="welcome_voices_description">Reed, Shelley, Bobby, Rocko, Glen, Sandy, Grandma, Grandpa e Luna. Tutte sono regolabili. Luna è un profilo femminile creato per questa app.</string>
    <string name="welcome_languages">Otto varianti linguistiche</string>
    <string name="welcome_languages_description">Inglese statunitense e britannico, tedesco, spagnolo di Spagna e Messico, francese di Francia e Canada e italiano. Nove voci per variante. Scegline una o lascia che ogni app richieda la propria lingua.</string>
    <string name="welcome_web">Lettura di pagine web</string>
    <string name="welcome_web_description">Annuncia link, titoli, grassetto, corsivo, elenchi, citazioni e immagini quando il testo contiene queste informazioni.</string>
    <string name="welcome_code">Lettura del codice</string>
    <string name="welcome_code_description">Riconosce camelCase, operatori e rientri nel codice.</string>
    <string name="welcome_spelling">Ortografia e simboli</string>
    <string name="welcome_spelling_description">Compita le parole e legge punteggiatura, emoji e numeri.</string>
    <string name="welcome_dictionaries">Dizionari personalizzati</string>
    <string name="welcome_dictionaries_description">Personalizza nomi e abbreviazioni e importa elenchi. Le voci attive dipendono dalla memoria disponibile.</string>
    <string name="welcome_permissions">Verranno richieste le autorizzazioni per le notifiche e l’esclusione dall’ottimizzazione della batteria. L’esclusione aiuta a mantenere la voce attiva a schermo spento. La voce funziona anche senza queste autorizzazioni.</string>
    <string name="welcome_about">Puoi cambiare le impostazioni più tardi. La schermata principale apre le impostazioni vocali, il generatore audio e questa introduzione.</string>
    <string name="welcome_codes">Numeri e codici di verifica</string>
    <string name="welcome_codes_description">Legge numeri lunghi per cifre, coppie o terne. I codici rilevati vengono letti cifra per cifra: 4 9 2 8 0 1.</string>
    <string name="welcome_routing">Canale audio</string>
    <string name="welcome_routing_description">Ogni app può scegliere il canale. Puoi inviare la voce ad accessibilità, contenuti multimediali o entrambi.</string>
    <string name="welcome_continue">Inizia</string>
    <string name="welcome_back_to_main">Torna alla schermata principale</string>
