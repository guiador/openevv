    <string name="welcome_title">Welcome to OpenEVV</string>
    <string name="welcome_alternative">A free voice that reads to you, without a subscription.</string>
    <string name="welcome_free">No payments, accounts or subscriptions. The complete engine is included.</string>
    <string name="welcome_intro">The engine is ready. Explore its features and permissions that help keep speech active.</string>
    <string name="welcome_features">Features</string>
    <string name="welcome_voices">Nine voices</string>
    <string name="welcome_voices_description">Reed, Shelley, Bobby, Rocko, Glen, Sandy, Grandma, Grandpa and Luna. All are adjustable. Luna is a female profile created for this app.</string>
    <string name="welcome_languages">Eight language variants</string>
    <string name="welcome_languages_description">US and UK English, German, Spain and Mexico Spanish, France and Canada French, and Italian. Each has nine voices. Choose one or let each app request its language.</string>
    <string name="welcome_web">Web page reading</string>
    <string name="welcome_web_description">Announces links, headings, bold, italics, lists, quotes and images when the text includes that information.</string>
    <string name="welcome_code">Code reading</string>
    <string name="welcome_code_description">Recognizes camelCase, operators and indentation in source code.</string>
    <string name="welcome_spelling">Spelling and symbols</string>
    <string name="welcome_spelling_description">Spell words and read punctuation, emojis and numbers.</string>
    <string name="welcome_dictionaries">Custom dictionaries</string>
    <string name="welcome_dictionaries_description">Customize names and abbreviations and import word lists. Active entries depend on available memory.</string>
    <string name="welcome_permissions">Notification and battery optimization exemption permissions will be requested. The exemption helps keep speech active with the screen off. Speech works without granting them.</string>
    <string name="welcome_about">You can change these settings later. The main screen opens voice settings, the audio generator and this welcome screen.</string>
    <string name="welcome_codes">Numbers and verification codes</string>
    <string name="welcome_codes_description">Reads long numbers as digits, pairs or triplets. Detected verification codes are read digit by digit: 4 9 2 8 0 1.</string>
    <string name="welcome_routing">Audio channel</string>
    <string name="welcome_routing_description">Each app can choose its channel. You can also send speech to accessibility, media or both.</string>
