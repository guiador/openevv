    <string name="eq_text_11">Preamplification</string>
    <string name="eq_text_12">These profiles change the selected voice’s pitch, resonance, roughness and breathiness. Adjust each parameter afterwards or reset the voice.</string>
    <string name="eq_text_13">Deep</string>
    <string name="eq_text_14">High</string>
